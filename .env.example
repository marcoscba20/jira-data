# Jira connection settings
JIRA_URL=https://your-domain.atlassian.net
JIRA_USER=your-email@example.com
JIRA_TOKEN=your-api-token

# Optional: comma-separated list of project keys to download (leave empty for all projects)
JIRA_PROJECTS=

# Optional: directory where CSV files will be saved (default: output)
OUTPUT_DIR=output

# Azure Table Storage settings (for worklog export)
# Option 1: full connection string (recommended)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=xxx;AccountKey=xxx;EndpointSuffix=core.windows.net

# Option 2: account name + key (used when AZURE_STORAGE_CONNECTION_STRING is not set)
# AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
# AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key

# Optional: Azure Table name for worklogs (default: worklogs)
AZURE_TABLE_NAME=worklogs
