# Jira connection settings
JIRA_URL=https://your-domain.atlassian.net
JIRA_USER=your-email@example.com
JIRA_TOKEN=your-api-token

# Optional: comma-separated list of project keys to download (leave empty for all projects)
JIRA_PROJECTS=

# Optional: directory where CSV files will be saved (default: output)
OUTPUT_DIR=output
